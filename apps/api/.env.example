# Copier vers .env — jamais commite (voir .gitignore)

DATABASE_URL=postgresql://ubersclap:ubersclap_dev@localhost:5433/ubersclap
REDIS_URL=redis://localhost:6380

PORT=3000

# Generer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Geocodage / itineraire.
# GEO_PROVIDER=osm  -> OpenStreetMap, gratuit, sans cle (defaut).
# GEO_PROVIDER=google -> a activer avec GOOGLE_MAPS_API_KEY quand le volume grimpe.
# GEO_PROVIDER=osm
# Nominatim exige un User-Agent identifiable avec un contact reel.
# GEO_USER_AGENT=Uber's Clap/0.1 (contact@ubersclap.dev)
# Surcharger si auto-heberge (OSRM public = pas de SLA).
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSRM_URL=https://router.project-osrm.org

# Paiement de l'abonnement — Stripe (ADR-015). Voir STRIPE_SETUP.md.
# Tout est optionnel : sans STRIPE_SECRET_KEY l'API demarre normalement et les
# routes /v1/billing/* repondent 503 BILLING_NOT_CONFIGURED.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Identifiants de tarif (price_...) crees dans le tableau de bord Stripe.
# Les MONTANTS vivent chez Stripe, jamais dans le code : changer un prix ne doit
# demander ni deploiement de l'API ni mise a jour de l'app.
# STRIPE_PRICE_SOLO_MONTHLY=price_...
# STRIPE_PRICE_SOLO_YEARLY=price_...
# STRIPE_PRICE_BUSINESS_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_YEARLY=price_...
# Retours apres paiement — liens profonds vers l'app (defauts ci-dessous).
# BILLING_SUCCESS_URL=ubersclap://profil/abonnement?billing=success
# BILLING_CANCEL_URL=ubersclap://profil/abonnement?billing=cancel
# BILLING_PORTAL_RETURN_URL=ubersclap://profil/abonnement?billing=portal

# Services externes — non utilises au MVP
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# RESEND_API_KEY=
# GOOGLE_MAPS_API_KEY=
