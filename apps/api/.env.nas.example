# Fichier .env à créer sur le NAS, à côté de docker-compose.nas.yml — jamais
# commité (voir .gitignore). Copier ce modèle vers `.env` et compléter.

POSTGRES_USER=cadance
POSTGRES_PASSWORD=REMPLACER_par_un_mot_de_passe_genere
POSTGRES_DB=cadance

# Générer DEUX secrets distincts, un par ligne :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=REMPLACER_secret_genere_1
JWT_REFRESH_SECRET=REMPLACER_secret_genere_2

# Geocodage — OSM gratuit par défaut, contact réel exigé par Nominatim.
GEO_PROVIDER=osm
GEO_USER_AGENT=Cadance/0.1 (contact@ubersclap.dev)

# Stripe — optionnel au démarrage (STRIPE_SETUP.md). Sans clé, l'API démarre
# et /v1/billing renvoie une erreur explicite plutôt que de planter.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_SOLO_MONTHLY=price_...
# STRIPE_PRICE_SOLO_YEARLY=price_...
# STRIPE_PRICE_BUSINESS_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_YEARLY=price_...
