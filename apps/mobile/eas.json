{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cadance.micdev.fr/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cadance.micdev.fr/v1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6794410771",
        "appleTeamId": "UA9AKL6F38"
      }
    }
  }
}
