---
/**
 * Card — dérivée de apps/mobile/components/Card.tsx.
 *
 * Reprend : radius lg, fond surface, padding 20px (card-pad), shadow-soft.
 * Ajout web : hover translateY(-4px) + shadow-lift + bordure vers
 * indigo-soft 30 % (DESIGN_CONTEXT.md §9, §10). En thème sombre l'ombre
 * s'atténue, compensée par une bordure 1px border (§5).
 */
interface Props {
  /** Force l'état hover pour la démonstration du styleguide. */
  demoHover?: boolean;
  class?: string;
}

const { demoHover = false, class: extra = '' } = Astro.props;
---

<div class={`card ${demoHover ? 'st-hover' : ''} ${extra}`}>
  <slot />
</div>

<style>
  .card {
    background: var(--surface);
    border: 1px solid transparent;
    border-radius: var(--r-lg);
    padding: var(--card-pad);
    box-shadow: var(--shadow-soft);
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  .card:hover,
  .card.st-hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
    border-color: color-mix(in srgb, var(--indigo-soft) 30%, transparent);
  }

  :root[data-theme='dark'] .card {
    border-color: var(--border);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .card {
      border-color: var(--border);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card { transition: none; }
  }
</style>
