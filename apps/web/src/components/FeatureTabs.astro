  /* Les deux états occupent la même cellule : la carte garde sa hauteur,
     le contenu bascule — jamais de trou (§7). */
  .ma-out,
  .ma-in {
    grid-area: 1 / 1;
  }

  .ma-out {
    display: grid;
    gap: 6px;
  }

  .ma-in {
