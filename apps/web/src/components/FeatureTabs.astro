    0%, 14.4% { transform: translateY(108%); opacity: 1; animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1); }
    /* 940 ms : posée (glissement 420 ms, --ease-out). */
    26.1% { transform: translateY(0); opacity: 1; }
    /* 3 140 ms : fin de lecture (2 200 ms). */
    87.2% { transform: translateY(0); opacity: 1; }
    /* 3 360 ms : sortie en fondu (220 ms, --dur-base). */
    93.3% { transform: translateY(0); opacity: 0; }
    93.4% { transform: translateY(108%); opacity: 0; }
    /* 3 600 ms : ré-armée. */
    100% { transform: translateY(108%); opacity: 1; }
