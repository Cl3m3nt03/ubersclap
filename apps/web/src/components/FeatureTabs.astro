  /* ------------------------------------------------ repli mobile (étape 7)
     Onglets en rangée à défilement horizontal avec scroll-snap, téléphone
     en dessous, fragments réduits à un seul ou supprimés (§7).
     Aucun scroll horizontal de PAGE : seule la tablist défile, dans son
     propre conteneur (§12). */

  @media (max-width: 1023px) {
    .ft-panel { grid-template-columns: 1fr; }
    .ft-stage { justify-items: center; min-height: 560px; }
  }

  /* Le téléphone étant centré dans sa colonne, la gouttière droite se
     referme plus tôt : un seul fragment dès 1199px, sinon le second sort
     du container. */
  @media (max-width: 1199px) {
    .ft-frag-right-low { display: none; }
    .ft-frag-right { top: 20%; }
  }

  @media (max-width: 767px) {
    .ft-tablist {
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
