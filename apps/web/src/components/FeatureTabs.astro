  .ft-more:hover { text-decoration: underline; }
  .ft-more:focus-visible { outline: 2px solid var(--indigo); outline-offset: 3px; }

  /* ------------------------------------------------ scène */

  /* Scène SANS panneau : le téléphone est posé directement sur la page,
     centré dans sa colonne. Le panneau crème doublait le cadre d'une
     seconde boîte et poussait l'app sur le côté ; l'écran est l'objet, il
     n'a pas besoin d'un contenant. */
  .ft-stage {
    position: relative;
    display: grid;
    align-items: center;
    /* Le cadre se cale à gauche de sa colonne : la gouttière droite
       appartient aux fragments, qui restent dans le container (§7 — ne pas
