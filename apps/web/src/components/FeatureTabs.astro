    font-size: 12px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .scr-kpi-net { color: var(--phone-success); }

  /* Barre d'onglets du bas : composant PhoneTabBar (vraies icônes Lucide
     tracées jusqu'à (tabs)/_layout.tsx). */

  /* ------------------------------------------------ micro-action facturation
     Boucle 3 600 ms — transform et opacity uniquement (§10) :
       0 → 400      repos, les courses à facturer visibles
       400 → 520    appui (scale 0.97, 120 ms = --dur-fast)
       520 → 940    la facture glisse vers le haut (420 ms = --dur-slow,
                    --ease-out) PENDANT que le bloc facturable s'efface —
                    cohérence d'état : les courses facturées quittent la
                    liste des facturables
       940 → 3140   lecture (2 200 ms)
       3140 → 3360  fondu de sortie (220 ms = --dur-base), le bloc revient
       3360 → 3600  ré-armement (240 ms) */

  .scr-billable {
    display: grid;
    gap: 6px;
    background: var(--phone-surface);
    border: 1px solid var(--phone-border);
    border-radius: 12px;
    padding: 6px;
  }

  /* Deux colonnes complètes empilées (avant / après), clippées : la carte
     sort en translateY négatif pendant que la colonne « après » remonte du
     même delta (--ma-shift = hauteur carte − hauteur rangée) — les factures
     00038/00037 restent en registre parfait entre les deux états, seul le
     contenu défile. La ligne 00039 converge vers une hauteur de rangée
     normale, 00036 se révèle en bas : l'écran reste plein (§6, §7). */
  .ma-flow {
    --ma-shift: 52px;
    display: grid;
    overflow: hidden;
  }

  .ma-flow > .ma-flow-col {
    grid-area: 1 / 1;
    display: grid;
    gap: 6px;
    align-content: start;
    justify-content: stretch;
    grid-template-columns: 100%;
    min-width: 0;
    padding: 0;
  }

  .ma-flow > .ma-out {
    animation: ma-out 3600ms infinite, ma-flow-up 3600ms infinite;
  }

  .ma-flow > .ma-in {
    opacity: 0;
    animation: ma-in 3600ms infinite, ma-flow-settle 3600ms infinite;
  }

  @keyframes ma-flow-up {
