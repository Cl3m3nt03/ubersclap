      margin-inline: calc(-1 * var(--pad-inline));
      padding-inline: var(--pad-inline);
    }

    .ft-tablist::-webkit-scrollbar { display: none; }

    .ft-tab {
      flex: none;
      scroll-snap-align: start;
    }

    .ft-stage {
      min-height: 0;
      padding: 20px 16px;
    }

    /* Fragments supprimés sur téléphone : l'écran porte tout (§7). */
    .ft-fragment { display: none; }

    /* …mais leur information reste : le fragment principal devient une
       ligne de légende sous le téléphone (§7) — même donnée calculée. */
    .ft-legend { display: block; }
