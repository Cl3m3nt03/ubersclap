  /* Cohérence d'état + transformation (§7) : la carte des courses à facturer
     DEVIENT la ligne de facture pendant que le PDF glisse (520 → 940 ms),
     et redevient facturable au ré-armement. Opacity seule (§10). */
  .ma-out { animation: ma-out 3600ms infinite; }
  .ma-in { animation: ma-in 3600ms infinite; }

  /* Relais strict (§7 règle 6) : l'état sortant s'éteint COMPLÈTEMENT
     avant que l'entrant n'apparaisse — aucun instant où les deux textes
     sont lisibles ensemble (le mi-fondu superposait « 4 h 02 » et
     « 2 h 32 » en texte fantôme). Même tempo global : action 420 ms
     coupée en deux demi-fondus, sortie 220 ms idem. */
  @keyframes ma-out {
    0%, 14.4% { opacity: 1; }
    20.2%, 90.5% { opacity: 0; }
    93.3%, 100% { opacity: 1; }
  }

  @keyframes ma-in {
    0%, 20.2% { opacity: 0; }
    26.1%, 87.7% { opacity: 1; }
    90.5%, 100% { opacity: 0; }
  }

  /* Valeur qui suit la micro-action (encours, total du mois, fragment) :
     deux états empilés en crossfade, synchronisés sur la boucle. */
  .ma-swap { display: grid; }
  .ma-swap-before, .ma-swap-after { grid-area: 1 / 1; }
  .ma-swap-before { animation: ma-out 3600ms infinite; }
  .ma-swap-after { opacity: 0; animation: ma-in 3600ms infinite; }

  .frag-main .ma-swap-before,
