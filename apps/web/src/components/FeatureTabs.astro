---
/**
 * FeatureTabs — web-only. La section signature (DESIGN_CONTEXT.md §7).
 *
 * ÉTAT PHASE 7, ÉTAPES 1-4 :
 *  1. cinq panneaux dans le DOM, ARIA complet, bascule de visibilité seule ;
 *  2. écrans reconstruits en HTML/CSS depuis ref/ (barre d'onglets du bas
 *     comprise, listes pleines jusqu'au bas du cadre) ;
 *  3. fragments d'orbite — trois règles (§7) : un fragment AJOUTE une
 *     information absente de l'écran, reste dans le sujet de l'onglet, et ne
 *     recouvre jamais texte ou navigation (chevauchement bezel ≤ ~24px) ;
 *  4. micro-action FACTURATION uniquement (calibrage du tempo) : course
 *     terminée → appui → la facture PDF glisse vers le haut. Boucle 3,6 s,
 *     transform et opacity seulement, grammaire §10. Les quatre autres
 *     micro-actions attendent la validation de ce tempo.
 *
 * TRAÇABILITÉ DES PUCES : chaque argument est tracé vers une fonctionnalité
 * livrée (code ou FEATURES.md) — voir le tableau de la session. Aucune
 * promesse chiffrée non vérifiable.
 *
 * Écran TOUJOURS clair (§4), tokens light figés à la compilation. Données :
 * src/data/demo.ts, agrégats calculés, dates relatives uniquement.
 */
import {
  light,
  formatEuros,
  formatDuration,
  formatDistance,
  formatTime,
  initials,
  breakdownFromInclTax,
  sumCents,
  COURSE_STATUS_LABEL,
  COURSE_STATUS_TONE,
  INVOICE_STATUS_LABEL,
  EXPENSE_CATEGORY_LABEL,
} from '@cadance/shared';
import { createLandingDemo, relativeDayLabel } from '../data/demo';
import PhoneMockup from './PhoneMockup.astro';
import PhoneTabBar from './PhoneTabBar.astro';
import StatCard from './StatCard.astro';

const demo = createLandingDemo();
const agg = demo.aggregates;

/* ---- Écrans : tranches pleines. ---- */

const todayCourses = demo.display.todayCourses.slice(0, 7);
const clients = demo.clients.slice(0, 7);
const invoices = [...demo.display.invoices].reverse().slice(0, 5);
const expenses = demo.display.expenses.slice(0, 8);

/* ---- Valeurs des fragments : ce que l'écran NE montre PAS. ---- */

// Agenda — le trou avant la prochaine course, et le volume de demain.
const lastMorning = demo.display.todayCourses.filter((c) => c.status === 'COMPLETED').at(-1)!;
const anchor = demo.display.todayCourses.find(
  (c) => c.scheduledAt.getHours() === 14 && c.scheduledAt.getMinutes() === 30,
)!;
const gapMinutes = Math.round(
  (anchor.scheduledAt.getTime() -
    (lastMorning.scheduledAt.getTime() + lastMorning.durationMinutes * 60_000)) /
    60_000,
);

// Micro-action Agenda : la course de 14:30 se pose dans le créneau. Avant la
// pose, le créneau libre couvre TOUT le trou entre la fin de la dernière
// course du matin et la course suivante (16:00) — cohérence d'état.
const anchorIndex = todayCourses.indexOf(anchor);
const coursesBeforeAnchor = todayCourses.slice(0, anchorIndex);
const coursesAfterAnchor = todayCourses.slice(anchorIndex + 1);
const nextAfterAnchor = coursesAfterAnchor[0]!;
const fullGapMinutes = Math.round(
  (nextAfterAnchor.scheduledAt.getTime() -
    (lastMorning.scheduledAt.getTime() + lastMorning.durationMinutes * 60_000)) /
    60_000,
);
// Le reste à encaisser aujourd'hui — somme EXACTE des courses CONFIRMÉES
// affichées à l'écran (§7 : toute valeur de fragment est calculée).
const upcomingTotal = sumCents(
  todayCourses.filter((c) => c.status === 'CONFIRMED').map((c) => c.priceCents),
);

// Clients — la fiche du premier habitué. stats.totalCents de l'app somme
// TOUTES les courses non supprimées (clients.service.ts:62), payées ou non :
// le libellé est « chiffre d'affaires » (client/[id].tsx:124), pas
// « encaissés » — la course de 11:45 facturée ENVOYÉE y figure légitimement.
const topClient = demo.clients[0]!;
const topClientCourses = demo.month.courses.filter(
  (c) => c.client.id === topClient.id && c.status === 'COMPLETED',
);
const topClientTotal = sumCents(topClientCourses.map((c) => c.priceCents));

// Facturation — le détail HT/TVA/TTC que la liste ne montre pas.
const lastInvoice = invoices[0]!;
const lastBreakdown = breakdownFromInclTax(lastInvoice.totalInclTaxCents, 'NORMAL');

// Dépenses — le poste carburant agrégé.
const fuelExpenses = demo.month.expenses.filter((e) => e.category === 'FUEL');
const fuelTotal = sumCents(fuelExpenses.map((e) => e.amountCents));

// Micro-action Tableau de bord : les compteurs. 5 pas calculés depuis les
// agrégats (0 → 25 % → 50 % → 75 % → 100 %), affichés en crossfade — le
// compteur du §10 en version déterministe, opacity seule.
const counterSteps = (total: number) => [0, 0.25, 0.5, 0.75, 1].map((f) => Math.round(total * f));
const caSteps = counterSteps(agg.revenueCents).map((c) => formatEuros(c));
const courseSteps = counterSteps(agg.courseCount).map(String);
const tempsSteps = counterSteps(agg.workedMinutes).map((m) => formatDuration(m));

// Micro-action Dépenses : le ticket photographié devient la dépense du jour.
const scannedExpense = expenses[0]!;
const expensesRest = expenses.slice(1);
const expenseTotalBefore = agg.expenseCents - scannedExpense.amountCents;

// Micro-action Clients : la fiche de Karim s'ouvre, l'historique se remplit.
const historyCourses = demo.month.courses
  .filter((c) => c.client.id === topClient.id && c.status === 'COMPLETED')
  .slice(-5)
  .reverse();
const clientsRest = clients.slice(1);

// Tableau de bord — résultat net et distance, absents de l'écran.
// Net = CA affiché − dépenses affichées ; panier = CA affiché ÷ courses affichées.
const netCents = agg.revenueCents - agg.expenseCents;
const basketCents = Math.round(agg.revenueCents / agg.courseCount);

/**
 * formatDistance de shared ne groupe pas les milliers (l'app ne dépasse
 * jamais quelques dizaines de km par course). Pour un cumul mensuel,
 * le format FR du §3 impose l'espace insécable : « 1 254 km ».
 */
function formatDistanceGrouped(meters: number): string {
  return formatDistance(meters).replace(/\d{4,}/, (n) =>
    n.replace(/\B(?=(\d{3})+(?!\d))/g, ' '),
  );
}

/* ---- Micro-action facturation : la course facturée et son PDF. ---- */

// Facturation GROUPÉE (ADR-005, schemas.ts:288) : les 6 dernières courses
// terminées de Karim Belkacem sur une seule facture — le moment de
// récompense porte un montant à trois chiffres, calculé.
const billingClient = demo.clients[0]!;
const billableCourses = demo.month.courses
  .filter((c) => c.client.id === billingClient.id && c.status === 'COMPLETED')
  .slice(-6);
const billableTotal = sumCents(billableCourses.map((c) => c.priceCents));
const billableBreakdown = breakdownFromInclTax(billableTotal, 'NORMAL');
// Numéro suivant de la série — continuité chronologique (ADR-012).
const nextInvoiceNumber = (() => {
  const [year, seq] = demo.month.invoices.at(-1)!.invoiceNumber.split('-');
  return `${year}-${String(Number(seq) + 1).padStart(5, '0')}`;
})();

/* Tokens sémantiques de l'écran clair, figés. */
const screenStatusVars = [
  `--phone-success: ${light.success}`,
  `--phone-warning: ${light.warning}`,
  `--phone-danger: ${light.danger}`,
  `--phone-indigo-soft: ${light.indigoSoft}`,
].join('; ');

const invoiceToneVar: Record<string, string> = {
  PAID: 'var(--phone-success)',
  SENT: 'var(--phone-warning)',
  OVERDUE: 'var(--phone-danger)',
  DRAFT: 'var(--phone-ink-muted)',
  CANCELLED: 'var(--phone-danger)',
};

const courseToneVar: Record<string, string> = {
  neutral: 'var(--phone-ink-muted)',
  info: 'var(--phone-indigo)',
  success: 'var(--phone-success)',
  warning: 'var(--phone-warning)',
  danger: 'var(--phone-danger)',
};

/* ---- Les cinq onglets — puces tracées (voir tableau de session). ---- */

const tabs = [
  {
    key: 'agenda',
    label: 'Agenda et courses',
    title: 'Votre journée, dans l’ordre',
    args: [
      'Chaque course à sa place, les temps libres affichés',
      'Deux courses qui se chevauchent : signalé aussitôt',
      'Le prix suggéré d’après la distance, toujours modifiable',
    ],
  },
  {
    key: 'clients',
    label: 'Carnet clients',
    title: 'Vos habitués, retrouvés en un geste',
    args: [
      'La fiche se crée toute seule à la première course',
      'Historique et chiffre d’affaires par client',
      'Le téléphone du répertoire, sans double saisie',
    ],
  },
  {
    key: 'facturation',
    label: 'Facturation',
    title: 'La facture part avant le client',
    args: [
      'Numérotation continue, conforme et automatique',
      'Plusieurs courses sur une seule facture',
      'Le PDF prêt à partager dès l’émission',
    ],
  },
  {
    key: 'depenses',
    label: 'Dépenses',
    title: 'Chaque ticket compté, rien d’oublié',
    args: [
      'Carburant, péage, entretien : six catégories claires',
      'Le total du mois toujours sous les yeux',
      'Saisie à la pompe, même sans réseau',
    ],
  },
  {
    key: 'tableau',
    label: 'Tableau de bord',
    title: 'Votre mois, en trois chiffres vrais',
    args: [
      'Le chiffre d’affaires des courses terminées, pas des promesses',
      'Volume et temps de conduite calculés tout seuls',
      'Le résultat net après dépenses',
    ],
  },
] as const;

/* Barre d'onglets du bas : item actif selon l'écran. */
const TABBAR = [
  { key: 'tableau', label: 'Tableau' },
  { key: 'agenda', label: 'Agenda' },
  { key: 'clients', label: 'Clients' },
  { key: 'facturation', label: 'Factures' },
  { key: 'profil', label: 'Profil' },
] as const;
---

<section class="ft" aria-labelledby="ft-heading" style={screenStatusVars}>
  <h2 class="visually-hidden" id="ft-heading">Fonctionnalités</h2>

  <div class="ft-tablist" role="tablist" aria-label="Fonctionnalités de l’application">
    {tabs.map((tab, index) => (
      <button
        class="ft-tab"
        role="tab"
        id={`ft-tab-${tab.key}`}
        aria-selected={index === 0 ? 'true' : 'false'}
        aria-controls={`ft-panel-${tab.key}`}
        tabindex={index === 0 ? 0 : -1}
        type="button"
      >
        {tab.label}
        <span class="ft-tab-progress" aria-hidden="true"></span>
      </button>
    ))}
  </div>

  {tabs.map((tab, index) => (
    <div
      class="ft-panel"
      role="tabpanel"
      id={`ft-panel-${tab.key}`}
      aria-labelledby={`ft-tab-${tab.key}`}
      hidden={index !== 0}
    >
      <div class="ft-text">
        <h3 class="ft-title">{tab.title}</h3>
        <ul class="ft-args">
          {tab.args.map((arg) => (
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              <span>{arg}</span>
            </li>
          ))}
        </ul>
        <a class="ft-more" href="#fonctionnalites">En savoir plus</a>
      </div>

      <div class="ft-stage">
        <div class="ft-phone-wrap">
          <PhoneMockup width="min(280px, 68vw)">
            {tab.key === 'agenda' && (
              <div class="scr" aria-hidden="true">
                <p class="scr-eyebrow">Aujourd’hui</p>
                <p class="scr-title">Agenda</p>
                <div class="scr-list">
                  {coursesBeforeAnchor.map((course) => (
                    <div class="scr-course">
                      <span class="scr-course-time">{formatTime(course.scheduledAt)}</span>
                      <span class="scr-course-sep"></span>
                      <span class="scr-course-main">
                        <strong>{course.client.firstName} {course.client.lastName}</strong>
                        <em>{course.pickup.split(',')[0]} → {course.destination.split(',')[0]}</em>
                      </span>
                      <span class="scr-course-right">
                        <strong>{formatEuros(course.priceCents)}</strong>
                        <i style={`color: ${courseToneVar[COURSE_STATUS_TONE[course.status]]};`}>{COURSE_STATUS_LABEL[course.status]}</i>
                      </span>
                    </div>
                  ))}
                  <!-- Micro-action : le créneau libre DEVIENT la course de
                       14:30 (§7 : transformer, hauteur constante). Avant la
                       pose, le libre couvre tout le trou jusqu'à 16:00. -->
                  <div class="scr-slot ma-agenda">
                    <div class="ma-out scr-gap">
                      <span class="scr-gap-line"></span>
                      <span class="scr-gap-label">{formatDuration(fullGapMinutes)} libre</span>
                    </div>
                    <div class="ma-in scr-course scr-course-inset">
                      <span class="scr-course-time">{formatTime(anchor.scheduledAt)}</span>
                      <span class="scr-course-sep"></span>
                      <span class="scr-course-main">
                        <strong>{anchor.client.firstName} {anchor.client.lastName}</strong>
                        <em>{anchor.pickup.split(',')[0]} → {anchor.destination.split(',')[0]}</em>
                      </span>
                      <span class="scr-course-right">
                        <strong>{formatEuros(anchor.priceCents)}</strong>
                        <i style={`color: ${courseToneVar[COURSE_STATUS_TONE[anchor.status]]};`}>{COURSE_STATUS_LABEL[anchor.status]}</i>
                      </span>
                    </div>
                  </div>
                  {coursesAfterAnchor.map((course) => (
                    <div class="scr-course">
                      <span class="scr-course-time">{formatTime(course.scheduledAt)}</span>
                      <span class="scr-course-sep"></span>
                      <span class="scr-course-main">
                        <strong>{course.client.firstName} {course.client.lastName}</strong>
                        <em>{course.pickup.split(',')[0]} → {course.destination.split(',')[0]}</em>
                      </span>
                      <span class="scr-course-right">
                        <strong>{formatEuros(course.priceCents)}</strong>
                        <i style={`color: ${courseToneVar[COURSE_STATUS_TONE[course.status]]};`}>{COURSE_STATUS_LABEL[course.status]}</i>
                      </span>
                    </div>
                  ))}
                </div>
                <PhoneTabBar active="agenda" />
              </div>
            )}

            {tab.key === 'clients' && (
              <div class="scr" aria-hidden="true">
                <p class="scr-eyebrow">{demo.clients.length} enregistrés</p>
                <p class="scr-title">Clients</p>
                <div class="scr-search">Rechercher un client</div>
                <div class="scr-list">
                  <!-- Micro-action : appui sur la ligne de Karim → elle
                       DEVIENT sa fiche, l'historique apparaît ligne à ligne
                       (§7 : transformer, hauteur constante). -->
                  <div class="scr-clientcard ma-clients">
                    <div class="ma-out">
                      <div class="scr-client scr-client-inset ma-press">
                        <span class="scr-avatar">{initials(topClient.firstName, topClient.lastName)}</span>
                        <span class="scr-client-main">
                          <strong>{topClient.firstName} {topClient.lastName}</strong>
                          <em>{topClient.phone}</em>
                        </span>
                      </div>
                      {clientsRest.slice(0, 6).map((client) => (
                        <div class="scr-client scr-client-inset">
                          <span class="scr-avatar">{initials(client.firstName, client.lastName)}</span>
                          <span class="scr-client-main">
                            <strong>{client.firstName} {client.lastName}</strong>
                            <em>{client.company ?? client.phone}</em>
                          </span>
                        </div>
                      ))}
                    </div>
                    <div class="ma-in scr-fiche">
                      <div class="scr-fiche-head">
                        <span class="scr-avatar scr-avatar-lg">{initials(topClient.firstName, topClient.lastName)}</span>
                        <span class="scr-client-main">
                          <strong>{topClient.firstName} {topClient.lastName}</strong>
                          <em>{topClient.phone}</em>
                        </span>
                      </div>
                      <div class="scr-fiche-stats">
                        <span class="scr-fiche-stat"><strong>{topClientCourses.length}</strong><em>courses</em></span>
                        <span class="scr-fiche-stat"><strong>{formatEuros(topClientTotal)}</strong><em>de chiffre d’affaires</em></span>
                      </div>
                      <p class="scr-subhead">Historique</p>
                      {historyCourses.map((course, index) => (
                        <div class={`scr-course scr-course-inset ma-hist ma-hist-${index}`}>
                          <span class="scr-course-time">{formatTime(course.scheduledAt)}</span>
                          <span class="scr-course-sep"></span>
                          <span class="scr-course-main">
                            <strong>{relativeDayLabel(course.scheduledAt)}</strong>
                            <em>{course.pickup.split(',')[0]} → {course.destination.split(',')[0]}</em>
                          </span>
                          <strong class="scr-expense-amount">{formatEuros(course.priceCents)}</strong>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
                <PhoneTabBar active="clients" />
              </div>
            )}

            {tab.key === 'facturation' && (
              <div class="scr" aria-hidden="true">
                <p class="scr-eyebrow">Suivi des paiements</p>
                <p class="scr-title">Factures</p>
                <div class="scr-total">
                  <span class="scr-total-label">Encours à recouvrer</span>
                  <span class="scr-total-value ma-swap">
                    <span class="ma-swap-before">{formatEuros(agg.outstandingCents)}</span>
                    <span class="ma-swap-after">{formatEuros(agg.outstandingCents + billableTotal)}</span>
                  </span>
                </div>
                <!-- Micro-action : la carte des courses à facturer DEVIENT la
                     ligne de facture 2026-00039 en tête de liste (§7 :
                     transformer, jamais un trou). L'encours suit : +142,00 €.
                     Hauteur constante SANS rangée fantôme : deux colonnes
                     empilées dans un viewport clippé — la colonne « après »
                     est plus courte du delta carte→rangée, et remonte en
                     translateY(--ma-shift) pendant le crossfade. La ligne
                     00039 arrive à hauteur de rangée normale, une facture
                     plus ancienne (00036) se révèle en bas : l'écran reste
                     plein, seul le contenu défile. -->
                <div class="ma-flow">
                  <div class="ma-out ma-flow-col">
                    <div class="scr-billable">
                      <div class="scr-billable-head">
                        <span class="scr-billable-title">{billingClient.firstName} {billingClient.lastName}</span>
                        <span class="scr-billable-count">{billableCourses.length} courses à facturer</span>
                      </div>
                      <div class="scr-billable-row">
                        <span class="scr-billable-sum">{formatEuros(billableTotal)}</span>
                        <i style={`color: var(--phone-success);`}>{COURSE_STATUS_LABEL.COMPLETED}</i>
                      </div>
                      <span class="scr-cta ma-press">Générer la facture</span>
                    </div>
                    {invoices.slice(0, 3).map((invoice) => (
                      <div class="scr-invoice">
                        <span class="scr-invoice-main">
                          <strong>{invoice.invoiceNumber}</strong>
                          <em>{invoice.clientName}</em>
                        </span>
                        <span class="scr-invoice-right">
                          <strong>{formatEuros(invoice.totalInclTaxCents)}</strong>
                          <i style={`color: ${invoiceToneVar[invoice.status]};`}>{INVOICE_STATUS_LABEL[invoice.status]}</i>
                        </span>
                      </div>
                    ))}
                  </div>
                  <div class="ma-in ma-flow-col">
                    <div class="scr-invoice">
                      <span class="scr-invoice-main">
                        <strong>{nextInvoiceNumber}</strong>
                        <em>{billingClient.firstName} {billingClient.lastName} · {billableCourses.length} courses</em>
                      </span>
                      <span class="scr-invoice-right">
                        <strong>{formatEuros(billableTotal)}</strong>
                        <i style={`color: var(--phone-warning);`}>{INVOICE_STATUS_LABEL.SENT}</i>
                      </span>
                    </div>
                    {invoices.slice(0, 4).map((invoice) => (
                      <div class="scr-invoice">
                        <span class="scr-invoice-main">
                          <strong>{invoice.invoiceNumber}</strong>
                          <em>{invoice.clientName}</em>
                        </span>
                        <span class="scr-invoice-right">
                          <strong>{formatEuros(invoice.totalInclTaxCents)}</strong>
                          <i style={`color: ${invoiceToneVar[invoice.status]};`}>{INVOICE_STATUS_LABEL[invoice.status]}</i>
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
                <PhoneTabBar active="facturation" />
                <!-- Micro-action, temps 2 : le PDF glisse vers le haut.
                     Aperçu sobre : fond blanc, encre, filets, une touche
                     d'indigo (§8 bloc 5). -->
                <div class="ma-sheet">
                  <span class="ma-sheet-grab"></span>
                  <p class="ma-sheet-title">Facture {nextInvoiceNumber}</p>
                  <p class="ma-sheet-client">{billingClient.firstName} {billingClient.lastName} · {billableCourses.length} courses</p>
                  <div class="ma-sheet-lines">
                    <span class="ma-line"><em>Total HT</em><strong>{formatEuros(billableBreakdown.exclTax)}</strong></span>
                    <span class="ma-line"><em>TVA 10 %</em><strong>{formatEuros(billableBreakdown.tax)}</strong></span>
                    <span class="ma-line ma-line-total"><em>Total TTC</em><strong>{formatEuros(billableBreakdown.inclTax)}</strong></span>
                  </div>
                  <span class="ma-sheet-cta">Partager le PDF</span>
                </div>
              </div>
            )}

            {tab.key === 'depenses' && (
              <div class="scr" aria-hidden="true">
                <div class="scr-backrow"><span class="scr-back">‹</span><p class="scr-title scr-title-inline">Dépenses</p></div>
                <div class="scr-total">
                  <span class="scr-total-label">Total ce mois-ci</span>
                  <span class="scr-total-value ma-swap">
                    <span class="ma-swap-before">{formatEuros(expenseTotalBefore)}</span>
                    <span class="ma-swap-after">{formatEuros(agg.expenseCents)}</span>
                  </span>
                </div>
                <div class="scr-list">
                  <!-- Micro-action : la saisie d'une dépense — chip de
                       catégorie cochée (depense/nouvelle.tsx:112), montant
                       (:140), « Enregistrer la dépense » (:180) — DEVIENT la
                       dépense en tête de liste ; le total du mois suit
                       (§7 : transformer, hauteur constante). -->
                  <div class="scr-scan ma-depenses">
                    <div class="ma-out scr-entry">
                      <span class="scr-entry-chip">
                        <span class="scr-entry-check">✓</span>
                        {EXPENSE_CATEGORY_LABEL[scannedExpense.category]}
                      </span>
                      <span class="scr-entry-amount">{formatEuros(scannedExpense.amountCents)}</span>
                      <span class="scr-entry-cta ma-press">Enregistrer</span>
                    </div>
                    <div class="ma-in scr-expense scr-expense-inset">
                      <span class="scr-cat-ico"></span>
                      <span class="scr-expense-main">
                        <strong>{EXPENSE_CATEGORY_LABEL[scannedExpense.category]}</strong>
                        <em>{relativeDayLabel(scannedExpense.spentAt)} · {scannedExpense.description}</em>
                      </span>
                      <strong class="scr-expense-amount">{formatEuros(scannedExpense.amountCents)}</strong>
                    </div>
                  </div>
                  {expensesRest.map((expense) => (
                    <div class="scr-expense">
                      <span class="scr-cat-ico"></span>
                      <span class="scr-expense-main">
                        <strong>{EXPENSE_CATEGORY_LABEL[expense.category]}</strong>
                        <em>{relativeDayLabel(expense.spentAt)} · {expense.description}</em>
                      </span>
                      <strong class="scr-expense-amount">{formatEuros(expense.amountCents)}</strong>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {tab.key === 'tableau' && (
              <div class="scr" aria-hidden="true">
                <p class="scr-eyebrow">Bonjour, Julien</p>
                <p class="scr-title">Tableau de bord</p>
                <!-- Micro-action : les trois StatCards comptent — 5 pas
                     calculés en crossfade, teal puis coral puis purple en
                     léger décalé. Le seul écran où les trois gradients
                     apparaissent ensemble (§7). -->
                <div class="scr-stats ma-tableau">
                  <StatCard placement="mockup" tone="teal" label="Chiffre d’affaires">
                    <span slot="value" class="ma-counter ma-counter-teal">
                      {caSteps.map((step, index) => <span class={`ma-step ma-step-${index}`}>{step}</span>)}
                    </span>
                  </StatCard>
                  <div class="scr-stats-half">
                    <StatCard placement="mockup" tone="coral" label="Courses">
                      <span slot="value" class="ma-counter ma-counter-coral">
                        {courseSteps.map((step, index) => <span class={`ma-step ma-step-${index}`}>{step}</span>)}
                      </span>
                    </StatCard>
                    <StatCard placement="mockup" tone="purple" label="Temps">
                      <span slot="value" class="ma-counter ma-counter-purple">
                        {tempsSteps.map((step, index) => <span class={`ma-step ma-step-${index}`}>{step}</span>)}
                      </span>
                    </StatCard>
                  </div>
                </div>
                <p class="scr-subhead">Prochaine course</p>
                <div class="scr-course">
                  <span class="scr-course-time">{formatTime(anchor.scheduledAt)}</span>
                  <span class="scr-course-sep"></span>
                  <span class="scr-course-main">
                    <strong>{anchor.client.firstName} {anchor.client.lastName}</strong>
                    <em>{anchor.pickup.split(',')[0]} → {anchor.destination.split(',')[0]}</em>
                  </span>
                </div>
                <!-- Bloc « Ce mois-ci » de ref/ios-dashboard : distance,
                     dépenses, résultat net — valeurs calculées. -->
                <p class="scr-subhead">Ce mois-ci</p>
                <div class="scr-kpis">
                  <div class="scr-kpi">
                    <span class="scr-kpi-label">Distance parcourue</span>
                    <span class="scr-kpi-value">{formatDistanceGrouped(agg.distanceMeters)}</span>
                  </div>
                  <div class="scr-kpi">
                    <span class="scr-kpi-label">Dépenses</span>
                    <span class="scr-kpi-value">{formatEuros(agg.expenseCents)}</span>
                  </div>
                  <div class="scr-kpi">
                    <span class="scr-kpi-label">Résultat net</span>
                    <span class="scr-kpi-value scr-kpi-net">{formatEuros(netCents)}</span>
                  </div>
                </div>
                <PhoneTabBar active="tableau" />
              </div>
            )}
          </PhoneMockup>

        <!-- Étape 3 — fragments : chacun AJOUTE une information absente de
             l'écran, reste dans le sujet, ne recouvre jamais le contenu. -->
        <div class="ft-orbit" aria-hidden="true">
          {tab.key === 'agenda' && (
            <>
              <div class="ft-fragment ft-frag-right">
                <div class="frag-card">
                  <span class="frag-main ma-swap">
                    <span class="ma-swap-before">
                      <strong>{formatDuration(fullGapMinutes)} libre</strong>
                      <em>avant la course de {formatTime(nextAfterAnchor.scheduledAt)}</em>
                    </span>
                    <span class="ma-swap-after">
                      <strong>{formatDuration(gapMinutes)} libre</strong>
                      <em>avant la course de {formatTime(anchor.scheduledAt)}</em>
                    </span>
                  </span>
                </div>
              </div>
              <div class="ft-fragment ft-frag-right-low">
                <div class="frag-card">
                  <span class="frag-main">
                    <strong>{formatEuros(upcomingTotal)}</strong>
                    <em>encore à encaisser aujourd’hui</em>
                  </span>
                </div>
              </div>
            </>
          )}
          {tab.key === 'clients' && (
            <div class="ft-fragment ft-frag-right">
              <div class="frag-card frag-client">
                <span class="frag-avatar">{initials(topClient.firstName, topClient.lastName)}</span>
                <span class="frag-main">
                  <strong>{topClient.firstName} {topClient.lastName}</strong>
                  <em>{topClientCourses.length} courses · {formatEuros(topClientTotal)} de CA</em>
                </span>
              </div>
            </div>
          )}
          {tab.key === 'facturation' && (
            <div class="ft-fragment ft-frag-right">
              <div class="frag-card">
                <span class="frag-main">
                  <strong>{lastInvoice.invoiceNumber}</strong>
                  <em>HT {formatEuros(lastBreakdown.exclTax)} · TVA 10 % {formatEuros(lastBreakdown.tax)}</em>
                  <em>TTC {formatEuros(lastBreakdown.inclTax)}</em>
                </span>
              </div>
            </div>
          )}
          {tab.key === 'depenses' && (
            <div class="ft-fragment ft-frag-right">
              <div class="frag-card">
                <span class="frag-main">
                  <strong>Carburant · {formatEuros(fuelTotal)}</strong>
                  <em>{fuelExpenses.length} pleins ce mois-ci</em>
                </span>
              </div>
            </div>
          )}
          {tab.key === 'tableau' && (
            <>
              <div class="ft-fragment ft-frag-right">
                <div class="frag-card">
                  <span class="frag-main">
                    <strong>{formatEuros(basketCents)}</strong>
                    <em>de panier moyen par course</em>
                  </span>
                </div>
              </div>
              <div class="ft-fragment ft-frag-right-low">
                <div class="frag-card">
                  <span class="frag-main">
                    <strong>{formatEuros(agg.outstandingCents)}</strong>
                    <em>de factures à encaisser</em>
                  </span>
                </div>
              </div>
            </>
          )}
        </div>
        </div>

        <!-- Repli mobile (§7) : les fragments d'orbite sont cachés sous
             768px — leur information ne disparaît pas, le fragment principal
             devient cette ligne de légende sous le téléphone. Même donnée
             calculée, qui change avec l'onglet. -->
        <p class="ft-legend" aria-hidden="true">
          {tab.key === 'agenda' && (
            <span class="ma-swap">
              <span class="ma-swap-before">{formatDuration(fullGapMinutes)} libre avant la course de {formatTime(nextAfterAnchor.scheduledAt)}</span>
              <span class="ma-swap-after">{formatDuration(gapMinutes)} libre avant la course de {formatTime(anchor.scheduledAt)}</span>
            </span>
          )}
          {tab.key === 'clients' && (
            <span>{topClient.firstName} {topClient.lastName} · {topClientCourses.length} courses · {formatEuros(topClientTotal)} de CA</span>
          )}
          {tab.key === 'facturation' && (
            <span>{lastInvoice.invoiceNumber} · HT {formatEuros(lastBreakdown.exclTax)} · TVA 10 % {formatEuros(lastBreakdown.tax)} · TTC {formatEuros(lastBreakdown.inclTax)}</span>
          )}
          {tab.key === 'depenses' && (
            <span>Carburant · {formatEuros(fuelTotal)} · {fuelExpenses.length} pleins ce mois-ci</span>
          )}
          {tab.key === 'tableau' && (
            <span>{formatEuros(basketCents)} de panier moyen par course</span>
          )}
        </p>
      </div>
    </div>
  ))}
</section>

<script>
  /**
   * Étapes 1 + 5 : bascule + clavier, puis enchaînement automatique.
   *
   * - Un onglet reste affiché 7 200 ms = deux boucles de micro-action (§7).
   * - Barre de progression fine sur l'onglet actif (transform scaleX,
   *   pilotée par requestAnimationFrame — jamais width, §10).
   * - ARRÊT DÉFINITIF au premier clic/touche de l'utilisateur : on ne
   *   reprend jamais la main après une interaction (§7).
   * - Pause au survol de la section, reprise à la sortie.
   * - prefers-reduced-motion : aucun enchaînement (§7, étape 6 anticipée
   *   ici car l'enchaînement naît à cette étape).
   */
  const TAB_DURATION = 7200;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const root of document.querySelectorAll<HTMLElement>('.ft')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

    let autoplay = !reducedMotion;
    let paused = false;
    let elapsed = 0;
    let lastTick: number | null = null;
    let rafId = 0;

    function currentIndex() {
      return tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
    }

    function setProgress(fraction: number) {
      const active = tabs[currentIndex()];
      for (const tab of tabs) {
        const bar = tab.querySelector<HTMLElement>('.ft-tab-progress');
        if (bar) bar.style.transform = `scaleX(${tab === active ? fraction : 0})`;
      }
    }

    function select(index: number, focus = true) {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.tabIndex = active ? 0 : -1;
        const panel = panels[i];
        if (panel) panel.hidden = !active;
      });
      elapsed = 0;
      lastTick = null;
      if (focus) tabs[index]?.focus();
    }

    /** Le premier geste de l'utilisateur arrête l'enchaînement pour de bon. */
    function stopForever() {
      if (!autoplay) return;
      autoplay = false;
      cancelAnimationFrame(rafId);
      setProgress(0);
      root.classList.add('ft-manual');
    }

    let tick = (now: number) => {
      if (!autoplay) return;
      if (!paused) {
        if (lastTick !== null) elapsed += now - lastTick;
        if (elapsed >= TAB_DURATION) {
          select((currentIndex() + 1) % tabs.length, false);
        }
        setProgress(Math.min(1, elapsed / TAB_DURATION));
      }
      lastTick = now;
      rafId = requestAnimationFrame(tick);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        stopForever();
        select(index, false);
      });
      tab.addEventListener('keydown', (event) => {
        const current = currentIndex();
        let next: number | null = null;
        if (event.key === 'ArrowRight') next = (current + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (current - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        if (next !== null) {
          event.preventDefault();
          stopForever();
          select(next);
        }
      });
    });

    // Pause au survol de toute la section ; reprise à la sortie.
    root.addEventListener('mouseenter', () => {
      paused = true;
    });
    root.addEventListener('mouseleave', () => {
      paused = false;
      lastTick = null;
    });

    // Observateur PERSISTANT (§7) : hors écran, TOUT s'arrête — les boucles
    // CSS des micro-actions (classe ft-offscreen) et l'enchaînement (le
    // chrono ne tourne plus). Reprise à l'entrée. La règle « observateur
    // déconnecté après usage » (§10) vaut pour les révélations ponctuelles,
    // pas pour une animation continue.
    let visible = false;
    let started = false;
    const observer = new IntersectionObserver(
      (entries) => {
        visible = entries.some((e) => e.isIntersecting);
        root.classList.toggle('ft-offscreen', !visible);
        if (visible) {
          lastTick = null;
          if (autoplay && !started) {
            started = true;
            rafId = requestAnimationFrame(tick);
          }
        }
      },
      { threshold: 0.15 },
    );
    observer.observe(root);

    // Le tick ne compte que si la section est visible.
    const baseTick = tick;
    tick = function visibilityAwareTick(now: number) {
      if (!visible) {
        lastTick = null;
        rafId = requestAnimationFrame(visibilityAwareTick);
        return;
      }
      baseTick(now);
    };
  }
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ------------------------------------------------ onglets */

  .ft-tablist {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: var(--block-gap);
  }

  .ft-tab {
    display: inline-flex;
    align-items: center;
    height: var(--touch-secondary);
    padding: 0 20px;
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    background: var(--surface);
    color: var(--ink-muted);
    font: inherit;
    font-size: var(--text-label);
    font-weight: var(--weight-bold);
    cursor: pointer;
    transition: color var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out);
  }

  .ft-tab[aria-selected='true'] {
    background: var(--indigo);
    border-color: var(--indigo);
    color: white;
  }

  .ft-tab:focus-visible {
    outline: 2px solid var(--indigo);
    outline-offset: 3px;
  }

  /* Barre de progression fine de l'enchaînement (étape 5) : scaleX piloté
     par le script, jamais width (§10). Sur fond indigo de l'onglet actif. */
  .ft-tab {
    position: relative;
    overflow: hidden;
  }

  .ft-tab-progress {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 5px;
    height: 2px;
    border-radius: var(--r-pill);
    background: var(--surface);
    opacity: 0.6;
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
  }

  .ft-tab[aria-selected='false'] .ft-tab-progress { background: transparent; }

  /* Arrêt définitif : plus aucune barre. */
  .ft-manual .ft-tab-progress { display: none; }

  /* Hors écran (observateur persistant, §7) : toutes les boucles s'arrêtent. */
  .ft-offscreen :is(.ma-out, .ma-in, .ma-press, .ma-sheet, .ma-swap-before, .ma-swap-after, .ma-hist, .ma-step) {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .ft-tab-progress { display: none; }
  }

  /* ------------------------------------------------ panneaux */

  .ft-panel {
    display: grid;
    grid-template-columns: minmax(280px, 5fr) 7fr;
