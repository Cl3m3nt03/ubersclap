    .ft .ma-sheet { transform: translateY(0); }
    .ft [class*='ma-hist-'] { animation: none; opacity: 1; }
    .ft [class*='ma-step-'] { animation: none; opacity: 0; }
    .ft .ma-step-4 { animation: none; opacity: 1; }
  }
