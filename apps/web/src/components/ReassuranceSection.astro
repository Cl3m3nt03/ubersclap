---
/**
 * ReassuranceSection — web-only (DESIGN_CONTEXT.md §8 bloc 8).
 *
 * BANDE COMPACTE, pas une grille de cartes (§8) : la grille de six cartes
 * icône-titre-texte est le motif le plus reconnaissable du design généré
 * par IA — on retire, on ne restyle pas. Une ligne d'affirmations courtes,
 * icônes en ligne, aucune carte, aucune ombre.
 * « Aucune commission » et « export des données » vivent dans les Tarifs.
 *
 * TRAÇABILITÉ (même discipline que la conformité — toute affirmation non
 * traçable SAUTE) :
 *  - Connexions chiffrées, secrets protégés → DEPLOYMENT.md:472-478
 *    (« Sécurité production : HTTPS, variables secrètes protégées ») ;
 *    mots de passe hachés Argon2 → auth.service.ts:74.
 *  - RGPD, vos données restent les vôtres → SECURITY.md:415-417 (le
 *    produit doit respecter le RGPD) + droits consulter/modifier/supprimer
 *    (SECURITY.md:436-452).
 *  - Sauvegarde automatique → DEPLOYMENT.md:367 (« Backup automatique »)
 *    + :478 (backups obligatoires en production).
 *  - Hors-ligne → ADR-011, OfflineBanner.tsx.
 *  - (déplacées vers Tarifs) Aucune commission → MONETIZATION.md:15 ;
 *    export des données → SECURITY.md:454-460.
 *  - RETIRÉ : « hébergement France/UE » — aucune région d'hébergement
 *    n'est engagée dans le repo (DEPLOYMENT.md liste AWS en option, sans
 *    région). Ajouté au §15 : à réintégrer quand l'hébergement sera choisi.
 *
 * Icônes Lucide (§5) inline, stroke 2, currentColor.
 */
const items = [
  {
    icon: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
    label: 'Connexions chiffrées',
  },
  {
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
    label: 'RGPD : vos données restent les vôtres',
  },
  {
    icon: '<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/>',
    label: 'Sauvegarde automatique',
  },
  {
    icon: '<path d="m2 2 20 20"/><path d="M5.782 5.782A7 7 0 0 0 9 19h8.5a4.5 4.5 0 0 0 1.307-.193"/><path d="M21.532 16.5A4.5 4.5 0 0 0 17.5 10h-1.79A7.008 7.008 0 0 0 10 5.07"/>',
    label: 'Utilisable sans réseau',
  },
] as const;
---

<section class="rea" aria-labelledby="rea-titre">
  <div class="rea-inner">
    <h2 class="visually-hidden" id="rea-titre">Réassurance</h2>
    <ul class="rea-band">
      {items.map((item) => (
        <li class="rea-chip">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={item.icon}
          />
          <span>{item.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Bande compacte : c'est un filet de réassurance entre deux sections,
     pas une section à part entière — elle ne prend pas le rythme complet
     (§5 : le rythme régulier vaut pour les blocs de contenu). */
  .rea { padding: 0 0 calc(var(--section-y) / 2); }

  .rea-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--pad-inline);
  }

  /* Une ligne d'affirmations, séparées par des filets — aucune carte,
     aucune ombre (§8). */
  .rea-band {
    list-style: none;
    margin: 0;
    padding: 20px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: clamp(24px, 4vw, 56px);
    row-gap: 12px;
  }

  .rea-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    color: var(--ink-muted);
  }

  .rea-chip svg { color: var(--indigo); flex: none; }
</style>
